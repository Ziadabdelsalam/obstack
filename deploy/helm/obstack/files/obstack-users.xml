<!--
  obstack ClickHouse users (D11).

  Two distinct users, both defined here in config rather than created by
  convention at runtime:

    obstack_ingest  write path  — owns the `obstack` database and its DDL,
                                  applied by services/ingest at boot.
    obstack_web     read path   — readonly=2, SELECT only. The web app cannot
                                  write, and that is enforced by the server.

  Passwords come from the environment so this file carries no secrets; see
  deploy/compose/docker-compose.yml for the dev defaults.
-->
<clickhouse>
    <profiles>
        <obstack_ingest>
            <max_execution_time>60</max_execution_time>
        </obstack_ingest>

        <obstack_web>
            <!-- 2 = read queries and SET are allowed, INSERT and DDL are not. -->
            <readonly>2</readonly>
            <max_execution_time>30</max_execution_time>
        </obstack_web>
    </profiles>

    <users>
        <!-- D350: on Railway every service in the project shares one private
             network, so "loopback-only" is not a given the way it is under
             compose's `127.0.0.1:PORT:PORT` port bindings — the base image's
             own entrypoint only restricts `default` to loopback when neither
             CLICKHOUSE_USER nor CLICKHOUSE_PASSWORD is set, and stops doing so
             the moment either is. Pin the restriction here instead, so it
             holds regardless of what env vars a deploy sets. The in-container
             healthcheck (clickhouse-client's SELECT 1 probe at
             deploy/compose/docker-compose.yml:26) runs over loopback and
             stays unaffected. -->
        <default>
            <networks replace="replace">
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
            </networks>
        </default>

        <obstack_ingest>
            <password from_env="OBSTACK_CLICKHOUSE_INGEST_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>obstack_ingest</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT ALL ON obstack.*</query>
            </grants>
        </obstack_ingest>

        <obstack_web>
            <password from_env="OBSTACK_CLICKHOUSE_WEB_PASSWORD"/>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>obstack_web</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON obstack.*</query>
            </grants>
        </obstack_web>
    </users>
</clickhouse>
