# obstack on Railway — variable names only, NEVER values.
#
# This file documents the Railway service variables named in
# deploy/railway/README.md (§2) and the inputs deploy/railway/smoke.ts reads.
# It is not consumed by anything — Railway variables are entered by hand (or
# `railway variables set`) per service, per environment (staging/production),
# per README.md §4. Every name below appears exactly once even where a
# variable is shared by more than one service (noted inline).

# ── every service — the port Railway healthchecks against ─────────────────

# README.md §1 sets this per service: 3000 on marketing and web (explicit,
# because Next standalone honours PORT and Railway's injected value would move
# the listener), 8080 on ingest (healthcheck routing only — the Go binary
# ignores PORT), 8123 on clickhouse. Not set on postgres.
PORT=

# ── marketing (GitHub-built, apps/web/Dockerfile, D356) ─────────────────────

# Fixed literal "mock" — selects the marketing build's data mode. Also a
# Railway BUILD ARG (Railway auto-passes a service variable as the build ARG
# of the same name because the Dockerfile already declares `ARG
# OBSTACK_DATA_MODE`, apps/web/Dockerfile:42-43) — set the same value here as
# a runtime variable too, or the boot check refuses to start (README.md §1
# "Build ARGs").
OBSTACK_DATA_MODE=

# Build ARG only (apps/web/Dockerfile:52-53, D329) — baked into marketing's
# static HTML at `next build`, no runtime effect. production:
# https://app.obstack.dev · staging: the staging web service's Railway-issued
# domain. Unset = same-host relative links (pre-S5 default).
OBSTACK_APP_ORIGIN=

# Build ARG only (apps/web/Dockerfile:60-61, D342) — set on BOTH web-image
# services (marketing and web); baked at build time, /status is prerendered.
# Unset until the Better Stack status page exists; the user has chosen
# https://status.obstack.dev for when it does.
OBSTACK_STATUS_MONITOR_URL=

# ── web (GitHub-built, apps/web/Dockerfile, D356) — OBSTACK_DATA_MODE and
#    OBSTACK_STATUS_MONITOR_URL above are ALSO set on this service (data
#    mode fixed to "live" instead of "mock"; monitor URL is the same value
#    on both) ──────────────────────────────────────────────────────────────

# ClickHouse read access. URL is fixed (http://clickhouse.railway.internal:8123);
# USER is the fixed literal obstack_web; PASSWORD is generated (user) and
# shared with the clickhouse service below.
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Session cookie signing key. openssl rand -base64 32 (user), distinct value
# per environment (staging vs production).
BETTER_AUTH_SECRET=

# = OBSTACK_APP_URL below (staging: the Railway-issued domain; production:
# https://app.obstack.dev). D119/D348.
BETTER_AUTH_URL=

# staging: polar-sandbox · production: polar. NEVER "fake" or "polar-sandbox"
# in production (D344).
OBSTACK_BILLING_MODE=

# Polar dashboard (user, U14).
POLAR_ACCESS_TOKEN=

# Polar webhook endpoint config (user).
POLAR_WEBHOOK_SECRET=

# staging: the Railway-issued domain · production: https://app.obstack.dev
OBSTACK_APP_URL=

# Polar catalog (user) — environment-bound product id, not a secret.
POLAR_PRODUCT_PRO=

# Fixed: https://ingest.obstack.dev
OBSTACK_PUBLIC_OTLP_HTTP_ENDPOINT=

# Fixed: https://ingest-grpc.obstack.dev — set ONLY if the D336 staging gRPC
# proof passed (README.md §1); otherwise leave unset entirely.
OBSTACK_PUBLIC_OTLP_GRPC_ENDPOINT=

# Fixed: fake. K5 — no Explain key ships with this launch.
OBSTACK_EXPLAIN_MODE=

# Not set in this launch (K5 fake-mode decision).
OBSTACK_EXPLAIN_API_KEY=
ANTHROPIC_API_KEY=

# Not set in this launch — only relevant when OBSTACK_EXPLAIN_MODE=anthropic.
OBSTACK_EXPLAIN_MODEL=
OBSTACK_EXPLAIN_BASE_URL=

# ── shared — Postgres DSN (web AND ingest both read this name) ────────────

# Derived from POSTGRES_PASSWORD below: postgres://obstack:<password>@
# postgres.railway.internal:5432/obstack
OBSTACK_POSTGRES_DSN=

# ── ingest (GitHub-built, services/ingest/Dockerfile, D356) ─────────────────

# Fixed shape: clickhouse://obstack_ingest:<password>@
# clickhouse.railway.internal:9000/obstack — password shared with the
# clickhouse service below.
CLICKHOUSE_DSN=

# Unset until a Vercel log drain exists (D348); Vercel drain settings (user)
# when it does.
OBSTACK_VERCEL_DRAIN_SECRET=

# Code-level defaults — set only to override.
OBSTACK_OTLP_GRPC_ADDR=
OBSTACK_OTLP_HTTP_ADDR=
OBSTACK_ADMIN_ADDR=

# ── clickhouse (GitHub-built, deploy/railway/clickhouse/Dockerfile, D356) ───

# Generated (user) — shared with ingest's CLICKHOUSE_DSN above.
OBSTACK_CLICKHOUSE_INGEST_PASSWORD=

# Generated (user) — shared with web's CLICKHOUSE_PASSWORD above.
OBSTACK_CLICKHOUSE_WEB_PASSWORD=

# ── postgres (image: postgres:17.11) ────────────────────────────────────────

# Fixed literal: obstack
POSTGRES_USER=

# Generated (user) — source of OBSTACK_POSTGRES_DSN above.
POSTGRES_PASSWORD=

# Fixed literal: obstack
POSTGRES_DB=

# Fixed literal: /var/lib/postgresql/data/pgdata (matches the volume mount).
PGDATA=

# ── deploy/railway/smoke.ts inputs (operator shell only, not a Railway var) ─

# Marketing origin to probe, e.g. https://obstack.dev
OBSTACK_SMOKE_MARKETING_URL=

# App origin to probe, e.g. https://app.obstack.dev
OBSTACK_SMOKE_APP_URL=

# Ingest origin to probe, e.g. https://ingest.obstack.dev
OBSTACK_SMOKE_INGEST_URL=

# Optional — only probed if set (README.md §1 gRPC proof).
OBSTACK_SMOKE_INGEST_GRPC_URL=

# Optional — an operator-issued ingest key, revoked after the smoke run.
# Enables the authenticated /v1/traces 2xx probe and the gRPC export leg.
OBSTACK_SMOKE_API_KEY=
