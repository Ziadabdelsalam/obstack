# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
# the venv packages/obstack-py's README and the sdk-py job both create here
.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/
# the D267 boot-check stamp (apps/web/src/server/mode-stamp.ts) — baked into
# the image at build time, never meant to land in a checkout; ignored anyway
# as insurance against a local stray copy (e.g. from testing the boot check
# by hand).
.obstack-mode-stamp

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the documented template beside the compose file (D279) — the
# thing a self-hoster is told to copy from, not a secret.
!deploy/compose/.env.example
!deploy/railway/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright artifacts
.playwright-mcp/

# pitch deck material (not app code)
pitchdeck-assets/
.DS_Store
.ziarmy/

# agent worktrees and other per-machine Claude Code state. The project
# settings file is the one exception: it declares the i-have-adhd plugin and
# its marketplace (`claude plugin install i-have-adhd@i-have-adhd --scope
# project`) so anyone opening the repo in Claude Code is offered the same
# plugin. Everything else under .claude/ stays local.
.claude/*
!.claude/settings.json

# the skip-traps' transcript: web.yml and go.yml `tee test-output.log` at the
# repo root so the trap can count skips, and reproducing either job locally
# leaves the file behind. The e2e drive needs no entry of its own — its build
# log, server log, seed output and transcript all go to OUT_DIR, which defaults
# to a temp directory outside the tree.
test-output.log

# the CloudWatch forwarder's built zip: the deployable artifact is produced by
# `npm run package` from the two tracked files it contains, and rebuilt in CI —
# checking it in would be a binary nobody diffs.
deploy/cloudwatch-forwarder/dist/

# the SDK tarball the install instructions produce: README.md's pre-release
# block and the quickstart's TypeScript tab both open with
# `npm pack ./packages/obstack-js`, whose path is repo-root-relative, so a
# reader who follows them lands `obstack-js-<version>.tgz` HERE. It is a build
# product regenerated by every pack — the same thing, for the same reason, that
# demo/sdk-sample-ts{,-ai7}/.gitignore already say — and reproducing the
# documented steps locally must not leave the tree dirty. Root-anchored so it
# cannot hide a tarball anywhere else.
/obstack-js-*.tgz
