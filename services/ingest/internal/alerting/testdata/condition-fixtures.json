[
  {
    "name": "valid/metric gauge avg over 5m, no filters",
    "condition": { "source": "metric", "metric": "system.cpu.utilization", "type": "gauge", "agg": "avg", "window": "5m", "op": ">", "threshold": 0.9, "filters": {} },
    "valid": true
  },
  {
    "name": "valid/metric gauge last over 1h, less-than",
    "condition": { "source": "metric", "metric": "queue.depth", "type": "gauge", "agg": "last", "window": "1h", "op": "<", "threshold": 1, "filters": {} },
    "valid": true
  },
  {
    "name": "valid/metric gauge min over 30m, negative threshold",
    "condition": { "source": "metric", "metric": "kafka.consumer.lag", "type": "gauge", "agg": "min", "window": "30m", "op": "<", "threshold": -50, "filters": {} },
    "valid": true
  },
  {
    "name": "valid/metric gauge max over 1h, zero threshold",
    "condition": { "source": "metric", "metric": "k8s.pod.restarts", "type": "gauge", "agg": "max", "window": "1h", "op": ">", "threshold": 0, "filters": { "k8s.namespace.name": "prod" } },
    "valid": true
  },
  {
    "name": "valid/metric sum sum over 15m",
    "condition": { "source": "metric", "metric": "http.server.errors", "type": "sum", "agg": "sum", "window": "15m", "op": ">", "threshold": 25, "filters": {} },
    "valid": true
  },
  {
    "name": "valid/metric sum rate over 5m with two filters",
    "condition": { "source": "metric", "metric": "http.requests", "type": "sum", "agg": "rate", "window": "5m", "op": ">", "threshold": 100, "filters": { "service.name": "checkout", "env": "prod" } },
    "valid": true
  },
  {
    "name": "valid/metric sum rate over 30m, fractional threshold",
    "condition": { "source": "metric", "metric": "llm.tokens", "type": "sum", "agg": "rate", "window": "30m", "op": ">", "threshold": 12.5, "filters": {} },
    "valid": true
  },
  {
    "name": "valid/metric histogram p50 over 5m",
    "condition": { "source": "metric", "metric": "http.server.duration", "type": "histogram", "agg": "p50", "window": "5m", "op": ">", "threshold": 250, "filters": {} },
    "valid": true
  },
  {
    "name": "valid/metric histogram p90 over 1h",
    "condition": { "source": "metric", "metric": "http.server.duration", "type": "histogram", "agg": "p90", "window": "1h", "op": ">", "threshold": 500, "filters": {} },
    "valid": true
  },
  {
    "name": "valid/metric histogram p95 over 15m with a filter",
    "condition": { "source": "metric", "metric": "http.server.duration", "type": "histogram", "agg": "p95", "window": "15m", "op": ">", "threshold": 800, "filters": { "http.route": "/v1/tickets/bulk" } },
    "valid": true
  },
  {
    "name": "valid/metric histogram p99 over 30m",
    "condition": { "source": "metric", "metric": "db.client.duration", "type": "histogram", "agg": "p99", "window": "30m", "op": ">", "threshold": 1500, "filters": {} },
    "valid": true
  },
  {
    "name": "valid/metric histogram avg over 30m, less-than",
    "condition": { "source": "metric", "metric": "http.server.duration", "type": "histogram", "agg": "avg", "window": "30m", "op": "<", "threshold": 10, "filters": {} },
    "valid": true
  },
